# ============================================================================
# SMART-BUILDING.RO ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local and fill in the values

# ============================================================================
# DATABASE
# ============================================================================
# Local development (Docker):
DATABASE_URL="mysql://smart_building:password123@db:3306/smart_building"

# Production (cPanel):
# DATABASE_URL="mysql://smart_building_user:strong_password@localhost/smart_building"

# ============================================================================
# NEXTAUTH CONFIGURATION
# ============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="sk-this-is-a-development-secret-min-32-chars-1234567890"

# Local development:
NEXTAUTH_URL="http://192.168.1.73:3000"

# Production:
# NEXTAUTH_URL="https://smart-building.ro"

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
NODE_ENV="development"
# NODE_ENV="production" (for production)

# ============================================================================
# EMAIL CONFIGURATION (Yahoo Mail)
# ============================================================================
EMAIL_USER="stroedaniel@yahoo.com"

# Yahoo App Password (create at https://login.yahoo.com/account/security)
# NOT your regular password - must be 16 characters with spaces
EMAIL_PASSWORD="xxxx xxxx xxxx xxxx"

SMTP_HOST="smtp.mail.yahoo.com"
SMTP_PORT=465
SMTP_SECURE=true

# Email recipient for contact form submissions
EMAIL_RECIPIENT="stroedaniel@yahoo.com"

# ============================================================================
# SITE CONFIGURATION
# ============================================================================
NEXT_PUBLIC_SITE_NAME="Smart-Building"
NEXT_PUBLIC_SITE_URL="http://192.168.1.73:3000"
# NEXT_PUBLIC_SITE_URL="https://smart-building.ro" (production)

# ============================================================================
# GOOGLE ANALYTICS (Optional)
# ============================================================================
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ============================================================================
# IMAGE OPTIMIZATION
# ============================================================================
NEXT_IMAGE_ALLOWED_DOMAINS="192.168.1.73,smart-building.ro,euroenerg.ro"

# ============================================================================
# DEBUG (Development only)
# ============================================================================
# DEBUG="*"
